{
  "name": "periodic-evidence-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24.0.0" },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "setup:repos": "node src/cli.js setup --config pilot.local.json",
    "test": "node --test",
    "demo": "node scripts/demo.mjs",
    "submit:reviewed-handoff": "node src/cli.js submit-reviewed-handoff",
    "e2e:reviewed-handoff": "node src/cli.js downstream-e2e",
    "check:package": "node scripts/check-package.mjs",
    "pilot": "node src/cli.js",
    "check": "node --check src/cli.js && node --test"
  },
  "dependencies": {
    "@azure/identity": "4.13.1",
    "@github/copilot-sdk": "1.0.18",
    "ajv": "8.17.1",
    "ajv-formats": "3.0.1"
  }
}
