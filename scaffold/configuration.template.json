  "sources": [
    {
      "id": "ado-excel-agent",
      "type": "ado",
      "adapterBinding": null,
      "credentialReference": null,
      "seedScopeIds": ["excel-agent-ado"],
      "settings": {
        "organization": "office",
        "project": "OC",
        "areaPath": "OC\\Excel\\Intelligence\\Copilot\\Excel Agent",
        "includeSubpaths": true,
        "wiqlEndpoint": "https://dev.azure.com/office/OC/_apis/wit/wiql?timePrecision=true&api-version=7.1",
        "batchEndpoint": "https://dev.azure.com/office/OC/_apis/wit/workitemsbatch?api-version=7.1",
        "wiqlTemplate": "SELECT [System.Id] FROM WorkItems WHERE [System.TeamProject] = 'OC' AND [System.WorkItemType] = 'Bug' AND [System.AreaPath] UNDER 'OC\\Excel\\Intelligence\\Copilot\\Excel Agent' AND [System.State] IN ('Resolved', 'Closed') AND [Microsoft.VSTS.Common.ResolvedReason] IN ('Fixed', 'Duplicate') AND [System.CreatedDate] >= '<START_UTC>' AND [System.CreatedDate] < '<END_UTC_EXCLUSIVE>' ORDER BY [System.Id]",
        "maxBatchIds": 200,
        "errorPolicy": "Fail",
        "snapshotPolicy": "Preserve WIQL asOf and use it for batch reads; capture id and rev. Do not equate query-time state with historical cutoff state.",
        "fields": [
          "System.Id", "System.WorkItemType", "System.Title", "System.State",
          "System.Reason", "System.CreatedDate", "System.AreaPath", "System.Tags",
          "Microsoft.VSTS.Common.ResolvedReason", "Microsoft.VSTS.CMMI.HowFound",
          "Office.Common.FeedbackSources", "Office.Common.CustomerType",
          "Office.Common.IcMID", "Office.Common.IcMIncidentIDs",
          "System.Description", "Microsoft.VSTS.TCM.ReproSteps",
          "Office.Common.IssueType", "Office.Common.LinkedToOCVIssue"
        ],
        "attachments": "do-not-download-by-default",
        "scanPrompt": null
      }
    },
    {
      "id": "icm-excel-agent",
      "type": "icm",
      "adapterBinding": null,
      "credentialReference": null,
      "seedScopeIds": ["excel-agent-icm"],
      "settings": {
        "queryId": "599514",
        "queryFiltersVerified": false,
        "intendedSeverities": ["S1", "S2", "S2.5"],
        "intendedProduct": "Excel Agent",
        "excludePureServiceReliability": true,
        "rings": ["Dogfood", "MSIT", "Production", "unknown"],
        "fieldsToPreserve": [
          "incidentId", "title", "createTime", "severity", "status",
          "serviceTeam", "impactedProduct", "deploymentRing",
          "problemDescription", "rootCause", "mitigationOrFix",
          "linkedAdoOrPR", "directLink"
        ],
        "ownerExportPolicy": "Explicitly label owner-provided provenance, confirmed scope and confirmation time. No authenticated-access claim."
      }
    },
    {
      "id": "workiq-workplace",
