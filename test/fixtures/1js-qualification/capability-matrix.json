      "semanticId": "excel-agent.aad.fixture-seeded-workbook",
      "title": "Enterprise Omni fixture adds to a seeded workbook value",
      "accountLane": "aad-enterprise",
      "composites": [
        "excel.prompt.submit",
        "excel.prompt.turn",
        "excel.prompt.turn",
        "excel.prompt.wait",
        "excel.workbook.read",
        "excel.workbook.seed",
        "excel.workbook.seed"
      ],
      "assertions": [
        {
          "provider": "account",
          "assertion": "lane",
          "parameters": {
            "expected": "aad-enterprise"
          }
        },
        {
          "provider": "workbook",
          "assertion": "exact",
          "parameters": {
            "cell": "A1",
            "expected": "15"
          }
        },
        {
          "provider": "workbook",
          "assertion": "unchanged",
          "parameters": {
            "cell": "B1",
            "from": {
              "kind": "resource",
              "provider": "workbook",
              "resource": "B1"
            },
            "observationMs": 5000
          }
        }
      ],
      "providers": ["account", "prompt", "workbook"],
      "operations": [
        "prompt.submit",
        "prompt.wait",
        "workbook.read-resource",
        "workbook.seed",
        "workbook.seed"
      ],
      "resources": ["workbook:A1", "workbook:B1"],
      "fixtures": [],
      "cleanup": []
    },
